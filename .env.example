# ==========================================
# HakkuAI Environment Configuration
# ==========================================

# Agent Configuration
HAKKUAI_AGENT_NAME=hakkuai_welfare_assistant
HAKKUAI_AGENT_PORT=8000
# Leave seed empty for auto-generated ephemeral key, or provide a secure 32+ character passphrase
HAKKUAI_AGENT_SEED=your_secret_seed_phrase_here_do_not_share

# Agentverse / Mailbox Configuration
# To enable Agentverse Mailbox for 24/7 connectivity without local public port forwarding:
# Set to 'true' and provide your Agentverse API Key / Mailbox Key
HAKKUAI_MAILBOX_ENABLED=false
AGENTVERSE_API_KEY=your_agentverse_api_key_here
AGENTVERSE_MAILBOX_KEY=your_agentverse_mailbox_key_here

# ASI:One / Network Configuration
ASI_ONE_ENABLED=true
HAKKUAI_NETWORK=testnet
AGENT_LOG_LEVEL=INFO

# Scheme Database Configuration
SCHEMES_DATA_PATH=data/schemes.json
